---
import BaseLayout from '../layouts/BaseLayout.astro';
import {socials,site} from '../data/site';
---
<BaseLayout title="Links" description="Public profiles, contact, and useful links for Fail Soft Labs."><section class="page-hero"><p class="eyebrow">Find the lab elsewhere</p><h1>Open channels.</h1><p class="intro">Public profiles and a place to send a signal.</p></section><div class="card-grid"><section class="panel"><h2>Socials &amp; code</h2>{socials.map(s=><a class="quick-link" href={s.href} target="_blank" rel="noopener noreferrer">{s.name} ↗</a>)}<p class="small muted">YouTube and Discord: links coming later.</p></section><section class="panel"><h2>Lab inbox</h2><a href={`mailto:${site.contact}`}>{site.contact}</a></section><section class="panel"><h2>Need a tool?</h2><p class="muted">Public lookups, security checks, and troubleshooting shortcuts.</p><a class="text-link" href="/tools/">Open Tools ↗</a></section></div><div class="section"></div></BaseLayout>
